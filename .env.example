# Copy to .env and fill in.  Never commit .env.

# Key that encrypts firewall passwords. Generate one with:
#   docker run --rm python:3.13-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# If left empty, a key is created in data/.firewall.key on first start - back it up either way.
FIREWALL_KEY=

# Signs login sessions. Generate with:  openssl rand -hex 32
# If left empty, one is created in data/.secret_key.
FLASK_SECRET_KEY=

# Set to true when users reach the portal over HTTPS (reverse proxy).
SESSION_COOKIE_SECURE=false

# Set to true when running behind a reverse proxy (nginx, Traefik, Caddy) so the
# audit log records the real client IP.
TRUST_PROXY=false

# Verify the firewalls' TLS certificates (false for self-signed certificates).
SOPHOS_VERIFY_SSL=false
